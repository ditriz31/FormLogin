<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LoginLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <style name="LoginInput">
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_input_default</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:maxLines">1</item>
    </style>

    <style name="LoginTooltip">
        <item name="android:background">@drawable/bg_tooltip</item>
        <item name="android:elevation">4dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:text">@string/min_6_characters</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">italic</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="LoginButton" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="android:text">@string/log_in</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/green_primary</item>
        <item name="cornerRadius">4dp</item>
    </style>

    <style name="LoginLink">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/green_primary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>
</resources>
