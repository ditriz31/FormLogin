<?xml version="1.0" encoding="utf-8"?>
<!-- Versi 2: Form Login menggunakan RelativeLayout -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".RelativeLoginActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageView
            android:id="@+id/ivLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="100dp"
            android:contentDescription="@string/logo_description"
            android:src="@drawable/ic_logo" />

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/ivLogo"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="56dp"
            android:text="@string/welcome_back"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEmailLabel"
            style="@style/LoginLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvWelcome"
            android:layout_alignParentStart="true"
            android:layout_marginTop="28dp"
            android:text="@string/label_email" />

        <EditText
            android:id="@+id/etEmail"
            style="@style/LoginInput"
            android:layout_width="match_parent"
            android:layout_below="@id/tvEmailLabel"
            android:layout_marginTop="8dp"
            android:autofillHints="emailAddress"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress" />

        <TextView
            android:id="@+id/tvPasswordLabel"
            style="@style/LoginLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/etEmail"
            android:layout_alignParentStart="true"
            android:layout_marginTop="16dp"
            android:text="@string/label_password" />

        <EditText
            android:id="@+id/etPassword"
            style="@style/LoginInput"
            android:layout_width="match_parent"
            android:layout_below="@id/tvPasswordLabel"
            android:layout_marginTop="8dp"
            android:autofillHints="password"
            android:hint="@string/hint_password"
            android:inputType="textPassword" />

        <!-- Tooltip melayang di kanan atas kolom password -->
        <TextView
            android:id="@+id/tvPasswordTooltip"
            style="@style/LoginTooltip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/etPassword"
            android:layout_alignParentEnd="true"
            android:layout_marginBottom="2dp"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tvForgotPassword"
            style="@style/LoginLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/etPassword"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="12dp"
            android:text="@string/forgot_password" />

        <Button
            android:id="@+id/btnLogin"
            style="@style/LoginButton"
            android:layout_width="match_parent"
            android:layout_below="@id/tvForgotPassword"
            android:layout_marginTop="16dp" />

        <!-- Bagian bawah: Don't have an account? Sign Up -->
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_centerHorizontal="true"
            android:layout_marginBottom="32dp">

            <TextView
                android:id="@+id/tvNoAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_account"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvSignUp"
                style="@style/LoginLink"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@id/tvNoAccount"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@id/tvNoAccount"
                android:text="@string/sign_up" />
        </RelativeLayout>
    </RelativeLayout>

</RelativeLayout>
